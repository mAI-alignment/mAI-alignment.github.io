---
// Switches between light and dark. The site follows the system theme until the reader chooses;
// choosing the system's own theme again clears the override. Hidden when JavaScript is off.
---

<button class="theme-toggle" type="button" data-theme-toggle hidden>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
  </svg>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const active = () => root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const render = () => {
      const next = active() === 'dark' ? 'light' : 'dark';
      button.dataset.active = active();
      button.setAttribute('aria-label', `Switch to ${next} theme`);
      button.title = `Switch to ${next} theme`;
    };

    button.addEventListener('click', () => {
      const next = active() === 'dark' ? 'light' : 'dark';
      const system = systemDark.matches ? 'dark' : 'light';
      try {
        if (next === system) localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {}
      if (next === system) delete root.dataset.theme;
      else root.dataset.theme = next;
      render();
    });

    systemDark.addEventListener('change', render);
    render();
    button.hidden = false;
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    border-color: var(--color-secondary);
    color: var(--color-accent);
  }

  /* Show the theme the button switches to. */
  .theme-toggle[data-active='light'] .theme-toggle__sun,
  .theme-toggle[data-active='dark'] .theme-toggle__moon {
    display: none;
  }
</style>
