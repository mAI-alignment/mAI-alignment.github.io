---
import type { Paper } from '../lib/updates';

interface Props {
  papers: Paper[];
  /** Heading level of paper titles, so the list fits the surrounding outline. */
  headingLevel?: 2 | 3;
  /** Show abstract and BibTeX disclosures (full Papers page) or only the citation (compact lists). */
  details?: boolean;
}

const { papers, headingLevel = 3, details = true } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ol class="paper-list">
  {
    papers.map((paper) => (
      <li class="paper">
        <Heading class="paper__title">
          <a href={paper.data.url}>{paper.data.title}</a>
        </Heading>
        <p class="paper__authors">{paper.data.authors.join(', ')}</p>
        <p class="paper__venue meta">
          {paper.data.venue ?? 'Preprint'}
          <span aria-hidden="true"> · </span>
          <time datetime={paper.data.date.toISOString().slice(0, 10)}>{paper.data.date.getUTCFullYear()}</time>
        </p>
        {paper.data.links.length > 0 && (
          <ul class="paper__links meta" aria-label={`Links for ${paper.data.title}`}>
            {paper.data.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        )}
        {details && paper.data.abstract && (
          <details class="paper__details">
            <summary>Abstract</summary>
            <p>{paper.data.abstract}</p>
          </details>
        )}
        {details && paper.data.bibtex && (
          <details class="paper__details">
            <summary>BibTeX</summary>
            <pre tabindex="0"><code>{paper.data.bibtex}</code></pre>
          </details>
        )}
      </li>
    ))
  }
</ol>

<style>
  .paper-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paper {
    max-width: var(--measure);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .paper:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .paper p {
    margin: 0;
  }

  .paper__title {
    margin: 0 0 var(--space-2);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .paper__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .paper__title a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .paper__authors {
    margin-bottom: var(--space-1) !important;
  }

  .paper__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .paper__details {
    margin-top: var(--space-3);
  }

  .paper__details summary {
    width: fit-content;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text);
  }

  .paper__details summary:hover {
    color: var(--color-accent);
  }

  .paper__details p {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .paper__details pre {
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    overflow-x: auto;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-code-bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
  }
</style>
