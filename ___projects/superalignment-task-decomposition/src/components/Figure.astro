---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** A local image imported in the MDX entry, e.g. `import plot from '../../assets/updates/plot.svg'`. */
  src: ImageMetadata;
  /** What the image shows, for people who cannot see it. Use "" only for purely decorative images. */
  alt: string;
  /** Visible caption: what the figure shows and its main takeaway. Supports inline HTML via the default slot instead. */
  caption?: string;
  /** Optional source or credit line. */
  credit?: string;
  /** Let the figure use the wider column (for plots with small labels, wide diagrams). */
  wide?: boolean;
  /** Set for the first figure when it appears near the top of the article, so it is not lazy-loaded. */
  priority?: boolean;
  /** Optional id so the figure can be linked to, e.g. "fig-1". */
  id?: string;
}

const { src, alt, caption, credit, wide = false, priority = false, id } = Astro.props;
const hasSlot = Astro.slots.has('default');
const maxWidth = wide ? 928 : 640;
// Never advertise a display size larger than the source, or the browser upscales small images.
const displayWidth = Math.min(src.width, maxWidth);
const widths = [displayWidth, displayWidth * 2].filter((w) => w <= src.width);
---

<figure class:list={['figure', { wide }]} id={id}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={`(min-width: ${wide ? 62 : 44}rem) ${displayWidth}px, 100vw`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
  />
  {
    (caption || hasSlot || credit) && (
      <figcaption>
        {hasSlot ? <slot /> : caption}
        {credit && <span class="figure__credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin-inline: 0;
  }

  /* Fill the column, but never upscale an image beyond its natural size (keeps small images sharp). */
  .figure :global(img) {
    display: block;
    box-sizing: content-box;
    width: auto;
    max-width: calc(100% - 2 * var(--space-3));
    height: auto;
    padding: var(--space-3);
    border-radius: var(--radius);
    background: var(--color-figure-plate);
    margin-inline: auto;
  }

  figcaption {
    max-width: var(--measure);
    margin: var(--space-3) auto 0;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--color-muted);
  }

  figcaption :global(strong:first-child) {
    color: var(--color-text);
  }

  .figure__credit {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--step--2);
  }
</style>
